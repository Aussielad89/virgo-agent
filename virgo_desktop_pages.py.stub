from PyQt6.QtWidgets import QWidget, QVBoxLayout, QTableView, QLineEdit, QPushButton, QHBoxLayout, QLabel, QMessageBox
from PyQt6.QtCore import Qt, QAbstractTableModel, QSortFilterProxyModel
import _mem0_memory

class MemoryTableModel(QAbstractTableModel):
    def __init__(self, memory_cache: _mem0_memory.SQLiteMemoryCache):
        super().__init__()
        self._cache = memory_cache
        self._data = []
        self.refresh()
    
    def rowCount(self, parent=None):
        return len(self._data)
    
    def columnCount(self, parent=None):
        return 3
    
    def headerData(self, section, orientation, role=Qt.ItemRole.DisplayRole):
        if orientation == Qt.Orientation.Horizontal and role == Qt.ItemRole.DisplayRole:
            return ['Key', 'Value (truncated)', 'Expiration'][section]
        return super().headerData(section, orientation, role)
    
    def data(self, index, role=Qt.ItemRole.DisplayRole):
        if not index.isValid() or role != Qt.ItemRole.DisplayRole:
            return None
        key, value = self._data[index.row()]
        if index.column() == 0:
            return key
        elif index.column() == 1:
            return str(value)[:100] + '...' if len(str(value)) > 100 else str(value)
        return None
    
    def refresh(self):
        self.layoutAboutToBeChanged.emit()
        self._data = self._cache.get_all()
        self.layoutChanged.emit()

class MemoryExplorerPage(PageWidget):
    def __init__(self, memory_cache: _mem0_memory.SQLiteMemoryCache):
        super().__init__("Memory Explorer", "Browse, search, and manage agent memory")
        
        # Search bar
        search_box = QHBoxLayout()
        self.search_input = QLineEdit()
        self.search_input.setPlaceholderText('Search by key...')
        search_box.addWidget(QLabel('Search:'), 1)
        search_box.addWidget(self.search_input, 3)
        self.content.addLayout(search_box)
        
        # Table view
        self.model = MemoryTableModel(memory_cache)
        self.proxy = QSortFilterProxyModel()
        self.proxy.setSourceModel(self.model)
        self.proxy.setFilterKeyColumn(0)
        
        self.table = QTableView()
        self.table.setModel(self.proxy)
        self.table.horizontalHeader().setStretchLastSection(True)
        self.content.addWidget(self.table)
        
        # Buttons
        button_box = QHBoxLayout()
        self.refresh_btn = QPushButton('Refresh')
        self.clear_btn = QPushButton('Clear Expired')
        button_box.addWidget(self.refresh_btn, 1)
        button_box.addWidget(self.clear_btn, 1)
        self.content.addLayout(button_box)
        
        # Connections
        self.search_input.textChanged.connect(self._on_search)
        self.refresh_btn.clicked.connect(self.model.refresh)
        self.clear_btn.clicked.connect(memory_cache.cleanup)
        
        # Context menu
        self.table.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
        self.table.customContextMenuRequested.connect(
            lambda pos: self._show_context_menu(pos)
        )
    
    def _on_search(self, text):
        self.proxy.setFilterRegExp(text)
    
    def _show_context_menu(self, pos):
        menu = self.table.createStandardContextMenu(pos)
        delete_action = menu.addAction('Delete Entry')
        selected = self.table.selectedIndexes()
        if not selected:
            return
        
        action = menu.exec(self.table.viewport().mapToGlobal(pos))
        if action == delete_action:
            key = self.model.data(selected[0], Qt.ItemRole.DisplayRole)
            if key and QMessageBox.question(
                self, 'Confirm Delete', f'Sure you want to delete memory entry \"{key}\"?',
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
            ) == QMessageBox.StandardButton.Yes:
                self._cache.set(key, None, 0)  # Delete by setting TTL=0
                self.model.refresh()